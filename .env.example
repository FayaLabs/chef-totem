# Aponta para o mesmo pool do resto-saas (ChefControl). O totem le o cardapio e
# grava pedidos no MESMO tenant, entao o pedido cai na cozinha que ja existe.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Identidade deste aparelho. Um totem por unidade, cada um com seu id.
VITE_TOTEM_ID=totem-01
VITE_TENANT_ID=
VITE_UNIT_ID=

# Sessao de aparelho (M3): o totem autentica como um usuario de servico do
# tenant, entao a RLS continua valendo e o pedido tem autor.
VITE_TOTEM_DEVICE_EMAIL=
VITE_TOTEM_DEVICE_PASSWORD=

# live (padrao) le o pool do resto-saas. demo usa o cardapio de
# src/menu/demo-catalog.ts — dev, CI e screenshots. Nunca e fallback.
VITE_TOTEM_CATALOG=live

# Assistente. `scripted` = cerebro e ferramentas reais, falas roteirizadas (sem
# custo e sem microfone). `voice` = OpenAI Realtime por WebRTC, e exige a edge
# function `totem-voice-token` publicada com OPENAI_API_KEY no projeto.
VITE_TOTEM_ASSISTANT=on
VITE_TOTEM_WAITER=scripted

# Qual restaurante de demonstracao roda com VITE_TOTEM_CATALOG=demo.
# `?tenant=cafe-sabor` na URL ganha desta variavel — numa feira ninguem
# reinicia um servidor para mostrar o segundo restaurante.
VITE_TOTEM_DEMO_TENANT=zedek
