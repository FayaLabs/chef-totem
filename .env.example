# O mesmo cluster do PDV e da cozinha. O totem le o cardapio e grava pedidos no
# MESMO tenant, entao a venda do quiosque cai na mesma cozinha e no mesmo
# Financeiro que o caixa — nao numa fila paralela.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Identidade deste aparelho. Um totem por unidade, cada um com seu id.
VITE_TOTEM_ID=totem-01
VITE_TENANT_ID=
VITE_UNIT_ID=

# Sessao de aparelho (M3): o totem autentica como um usuario de servico do
# tenant, entao a RLS continua valendo e o pedido tem autor. O usuario e criado
# por `node scripts/provision-totem.mjs --tenant <uuid>`; a associacao (papel
# `totem_kiosk`) e concedida em SQL.
VITE_TOTEM_DEVICE_EMAIL=
VITE_TOTEM_DEVICE_PASSWORD=

# live (padrao) le o pool do resto-saas. demo usa o cardapio de
# src/menu/demo-catalog.ts — dev, CI e screenshots. Nunca e fallback.
VITE_TOTEM_CATALOG=live

# Assistente. `scripted` = cerebro e ferramentas reais, falas roteirizadas (sem
# custo e sem microfone). `voice` = OpenAI Realtime por WebRTC, e exige a edge
# function `totem-voice-token` publicada com OPENAI_API_KEY no projeto.
VITE_TOTEM_ASSISTANT=on
VITE_TOTEM_WAITER=scripted

# Qual das tres casas de demonstracao roda com VITE_TOTEM_CATALOG=demo:
# cafe-sabor | pizza-house | maxburger. Ver docs/DEMO-TENANTS.md.
#
# Esta variavel e so o PADRAO da maquina. Quem manda numa feira e o painel de
# servico do proprio totem (toque na etiqueta do canto superior direito, a que
# diz a casa e a build), que grava a escolha e sobrevive a reload — e
# `?tenant=` na URL ganha dos dois. Ninguem reinicia um servidor com cliente na
# frente.
VITE_TOTEM_DEMO_TENANT=pizza-house

# Dev only, and it must NOT live in this file's real counterpart. Vite reads
# plain `.env` during `vite build` too, so a URL here is inlined into the
# production bundle. Put it in `.env.development.local`, which only the dev
# mode loads:
#
#   VITE_TOTEM_VOICE_TOKEN_URL=https://<host>:3005/token
#
# It mints the realtime ephemeral secret from a plain local endpoint instead of
# the `totem-voice-token` edge function, so the voice waiter can be tested
# without Supabase. The code ignores it unless import.meta.env.DEV is true.

# ---------------------------------------------------------------------------
# Where the ORDER goes, which is not the same question as what is on the glass.
#
# `pool` (default) writes to the resto-saas pool with the device login above.
# `beautyplace` writes to a ChefControl cluster through one anon Edge Function
# door gated by a shared secret — so a demo house can be the theatre while the
# sale lands in a real tenant's kitchen, comanda and till. See
# docs/CLUSTER-ORDERS.md for the setup, and src/config/beautyplace.config.ts
# for why the secret lives here.
VITE_TOTEM_ORDER_BACKEND=pool

# The cluster's Supabase project and the house inside it.
VITE_BP_URL=
VITE_BP_ANON_KEY=
VITE_BP_TENANT_ID=

# Must match TOTEM_SHARED_SECRET in the cluster's Edge Function secrets.
VITE_BP_TOTEM_KEY=

# Optional. The unit the sale belongs to; headquarters when empty.
VITE_BP_UNIT_ID=

# Optional. Which row of the cluster's `payment_method_types` registry each
# method settles as — the receivable (transaction_type C) side. Without them the
# cluster matches by name (Cartão de Crédito / Cartão de Débito / Pix).
VITE_BP_PAYMENT_TYPE_CREDIT=
VITE_BP_PAYMENT_TYPE_DEBIT=
VITE_BP_PAYMENT_TYPE_PIX=

# Optional. Where the money lands when the payment method does not say.
VITE_BP_BANK_ACCOUNT_ID=
