{
  "name": "chef-totem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5310 --strictPort",
    "dev:published-sdk": "cross-env FAYZ_SDK_SOURCE=published vite --port 5310 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5311 --strictPort",
    "typecheck": "./scripts/link-sdk.sh && tsc -p tsconfig.ci.json --noEmit",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "test": "vitest run",
    "test:watch": "vitest",
    "shell": "electron electron/main.cjs",
    "shell:dev": "cross-env TOTEM_URL=http://localhost:5310 electron electron/main.cjs",
    "pack": "npm run build && electron-builder --win --publish never",
    "panel": "./scripts/deploy-panel.sh",
    "panel:shell": "./scripts/deploy-panel.sh --shell",
    "link-sdk": "./scripts/link-sdk.sh",
    "typecheck:published": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fayz-ai/core": "^0.21.0",
    "@fayz-ai/sdk": "^0.19.1",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^0.400.0",
    "motion": "^13.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "electron": "44.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "description": "Chef Totem — painel de autoatendimento"
}
